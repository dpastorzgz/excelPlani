{
  "name": "html-project-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:server": "pwsh -NoProfile -File tests/integration/local-server.test.ps1",
    "test:server:windows": "pwsh -NoProfile -File tests/integration/local-server.test.ps1 -ServerShell powershell.exe",
    "build": "node scripts/build.mjs",
    "validate:release": "node scripts/validate-release.mjs"
  },
  "dependencies": {
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "jsdom": "27.0.1",
    "vitest": "4.1.12"
  }
}
